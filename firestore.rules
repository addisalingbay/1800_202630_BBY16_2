rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validPost() {
      return request.resource.data.keys().hasAll([
          'uid', 'username', 'title', 'description', 'tags', 'imageUrl', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'title', 'description', 'tags', 'imageUrl', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 80
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 10000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 10
        && (request.resource.data.imageUrl == null
          || (request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() <= 2048))
        && request.resource.data.createdAt == request.time;
    }

    function validComment() {
      return request.resource.data.keys().hasAll([
          'uid', 'username', 'text', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'text', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
    }

    match /posts/{postId} {
      // Signed-in users can read feed posts. Only the authenticated creator
      // can create a post whose uid matches their own Firebase Auth UID.
      allow read: if signedIn();
      allow create: if signedIn() && validPost();
      // Editing/deleting is intentionally disabled until those features are added.
      allow update, delete: if false;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && validComment();
        allow update, delete: if false;
      }
    }
  }
}
